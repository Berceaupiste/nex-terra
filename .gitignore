# ---------------------------------------------------------------------------
# NEX TERRA — root .gitignore
# ---------------------------------------------------------------------------

# Python (backend) — all nested, so no "back/" prefix needed
venv/
__pycache__/
.pytest_cache/
.coverage
coverage.xml
*.pyc
*.egg-info/
*.env
*.env.*

# Python data — generated demo cache (regenerates on demand)
back/data/nasa/*.json

# Frontend — node_modules + build output
node_modules/
dist/
.vite/
*.log
__pycache__/

# Jupyter / config
.ipynb_checkpoints/

# OS / editor
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Logs
*.log
